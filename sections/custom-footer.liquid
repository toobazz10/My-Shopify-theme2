{% comment %}
✅ EXACT NAME: custom-footer
✅ FULLY EDITABLE IN CUSTOMIZE
{% endcomment %}

<footer class="site-footer" style="background: {{ section.settings.footer_bg }}; color: {{ section.settings.text_color }};">
  <div class="footer-inner">
    <div class="footer-col">
      <h3>{{ section.settings.col1_title }}</h3>
      <p>{{ section.settings.col1_text }}</p>
    </div>
    <div class="footer-col">
      <h3>{{ section.settings.col2_title }}</h3>
      <div class="footer-links">
        {% for link in section.settings.links1.links %}
          <a href="{{ link.url }}">{{ link.title }}</a>
        {% endfor %}
      </div>
    </div>
    <div class="footer-col">
      <h3>{{ section.settings.col3_title }}</h3>
      <div class="footer-links">
        {% for link in section.settings.links2.links %}
          <a href="{{ link.url }}">{{ link.title }}</a>
        {% endfor %}
      </div>
    </div>
    <div class="footer-col">
      <h3>{{ section.settings.col4_title }}</h3>
      <div class="social-links">
        {% if section.settings.facebook %}<a href="{{ section.settings.facebook }}" target="_blank">📘</a>{% endif %}
        {% if section.settings.instagram %}<a href="{{ section.settings.instagram }}" target="_blank">📸</a>{% endif %}
      </div>
    </div>
  </div>
  <div class="footer-bottom">
    <p>{{ section.settings.copyright }}</p>
  </div>
</footer>

{% schema %}
{
  "name": "Custom Footer",
  "settings": [
    {
      "type": "color",
      "id": "footer_bg",
      "label": "Background Colour",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Colour",
      "default": "#ffffff"
    },
    {
      "type": "text",
      "id": "col1_title",
      "label": "Column 1 Heading",
      "default": "About Us"
    },
    {
      "type": "textarea",
      "id": "col1_text",
      "label": "Description",
      "default": "Everything you need in one place."
    },
    {
      "type": "text",
      "id": "col2_title",
      "label": "Column 2 Heading",
      "default": "Shop"
    },
    {
      "type": "menu",
      "id": "links1",
      "label": "Shop Links",
      "default": "footer-shop"
    },
    {
      "type": "text",
      "id": "col3_title",
      "label": "Column 3 Heading",
      "default": "Support"
    },
    {
      "type": "menu",
      "id": "links2",
      "label": "Support Links",
      "default": "footer-support"
    },
    {
      "type": "text",
      "id": "col4_title",
      "label": "Column 4 Heading",
      "default": "Follow Us"
    },
    {
      "type": "url",
      "id": "facebook",
      "label": "Facebook Link"
    },
    {
      "type": "url",
      "id": "instagram",
      "label": "Instagram Link"
    },
    {
      "type": "text",
      "id": "copyright",
      "label": "Copyright Text",
      "default": "© 2026 YOUR STORE. All rights reserved."
    }
  ],
  "presets": [{"name": "Custom Footer"}]
}
{% endschema %}

<style>
*{margin:0;padding:0;box-sizing:border-box;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif;}
.site-footer{padding:50px 15px 20px;}
.footer-inner{max-width:1200px;margin:0 auto;display:grid;grid-template-columns:repeat(4,1fr);gap:30px;margin-bottom:30px;}
.footer-col h3{font-size:16px;font-weight:600;margin-bottom:15px;}
.footer-col p{font-size:14px;line-height:1.6;opacity:.8;}
.footer-links{display:flex;flex-direction:column;gap:8px;}
.footer-links a{font-size:14px;text-decoration:none;opacity:.8;}
.social-links{display:flex;gap:12px;font-size:22px;}
.footer-bottom{max-width:1200px;margin:0 auto;padding-top:20px;border-top:1px solid rgba(255,255,255,.1);text-align:center;}

@media (max-width:768px){.footer-inner{grid-template-columns:repeat(2,1fr);}}
@media (max-width:480px){.footer-inner{grid-template-columns:1fr;}}
</style>
