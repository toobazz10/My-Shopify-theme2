{% comment %}
=== CUSTOM COLLECTION / CATALOGUE — FULLY EDITABLE ===
✅ Heading · Description · Colours · Layout · All editable
{% endcomment %}

<div class="custom-collection-page" style="background: {{ section.settings.page_bg }};">
  <section class="collection-header">
    <div class="header-inner">
      <h1 class="collection-title" style="color: {{ section.settings.heading_color }};">
        {{ collection.title }}
      </h1>
      {% if collection.description != blank %}
        <p class="collection-desc" style="color: {{ section.settings.text_color }};">
          {{ collection.description }}
        </p>
      {% endif %}
      <div class="product-count" style="color: {{ section.settings.meta_color }};">
        {{ collection.products_count }} product{% if collection.products_count != 1 %}s{% endif %}
      </div>
    </div>
  </section>

  <section class="filters-bar">
    <div class="filters-inner">
      <div class="filters-wrap">
        <button class="filter-toggle" id="filterToggle">🔍 Filters</button>
        <div class="filters-dropdown" id="filtersDropdown">
          <div class="filter-group">
            <h4>Price</h4>
            <label><input type="checkbox"> Under £20</label>
            <label><input type="checkbox"> £20 – £50</label>
            <label><input type="checkbox"> £50 – £100</label>
            <label><input type="checkbox"> Over £100</label>
          </div>
          <div class="filter-group">
            <h4>Availability</h4>
            <label><input type="checkbox" checked> In Stock</label>
            <label><input type="checkbox"> Out of Stock</label>
          </div>
        </div>
      </div>
      <div class="sort-wrap">
        <label for="sortBy">Sort by:</label>
        <select id="sortBy" class="sort-select">
          <option value="manual">Featured</option>
          <option value="price-asc">Price: Low → High</option>
          <option value="price-desc">Price: High → Low</option>
          <option value="title-asc">Name: A → Z</option>
          <option value="title-desc">Name: Z → A</option>
        </select>
      </div>
    </div>
  </section>

  <section class="products-section">
    <div class="products-grid">
      {% for product in collection.products %}
      <a href="{{ product.url }}" class="product-card">
        <div class="product-img">
          {{ product.featured_image | image_url: '400x' | image_tag: 'loading', 'lazy' }}
          {% if product.compare_at_price > product.price %}<span class="sale-badge">SALE</span>{% endif %}
        </div>
        <div class="product-info">
          <h3>{{ product.title | truncate:28 }}</h3>
          <div class="price-row">
            <span class="current-price">{{ product.price | money }}</span>
            {% if product.compare_at_price > product.price %}<span class="old-price">{{ product.compare_at_price | money }}</span>{% endif %}
          </div>
          <div class="rating">⭐⭐⭐⭐⭐</div>
          <span class="stock-tag {% if product.available %}in-stock{% else %}out-stock{% endif %}">
            {% if product.available %}In Stock{% else %}Out of Stock{% endif %}
          </span>
        </div>
      </a>
      {% else %}
      <div class="empty-state"><p>No products found.</p></div>
      {% endfor %}
    </div>
  </section>

  {% if collection.products.size > 16 %}
  <section class="pagination-section">
    <div class="pagination">
      {% if paginate.previous %}<a href="{{ paginate.previous.url }}" class="page-link">&larr; Previous</a>{% endif %}
      <span class="page-info">Page {{ paginate.current_page }} of {{ paginate.pages }}</span>
      {% if paginate.next %}<a href="{{ paginate.next.url }}" class="page-link">Next &rarr;</a>{% endif %}
    </div>
  </section>
  {% endif %}
</div>

{% schema %}
{
  "name": "Custom Collection",
  "settings": [
    {
      "type": "header",
      "content": "🎨 Colours"
    },
    {
      "type": "color",
      "id": "page_bg",
      "label": "Page Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Colour",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Description Colour",
      "default": "#555555"
    },
    {
      "type": "color",
      "id": "meta_color",
      "label": "Count / Meta Colour",
      "default": "#777777"
    }
  ],
  "presets": [
    {
      "name": "Custom Collection",
      "settings": {}
    }
  ]
}
{% endschema %}

<style>
*{margin:0;padding:0;box-sizing:border-box;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif;}
.custom-collection-page{width:100%;max-width:1200px;margin:0 auto;padding:0 15px;}
.collection-header{text-align:center;padding:30px 15px 20px;border-bottom:1px solid #eee;}
.collection-title{font-size:28px;font-weight:700;margin-bottom:8px;}
.collection-desc{font-size:15px;max-width:700px;margin:0 auto 10px;line-height:1.5;}
.product-count{font-size:14px;}
.filters-bar{padding:15px 0;border-bottom:1px solid #eee;position:relative;}
.filters-inner{display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:15px;}
.filter-toggle{background:#f5f5f5;border:none;padding:8px 16px;border-radius:6px;font-size:15px;cursor:pointer;}
.filters-dropdown{position:absolute;top:100%;left:15px;background:#fff;border:1px solid #eee;border-radius:8px;padding:15px;box-shadow:0 4px 12px rgba(0,0,0,.08);z-index:100;display:none;min-width:220px;}
.filters-dropdown.active{display:block;}
.filter-group{margin-bottom:12px;}
.filter-group h4{font-size:14px;font-weight:600;margin-bottom:6px;}
.filter-group label{display:block;font-size:14px;color:#444;margin:4px 0;cursor:pointer;}
.sort-wrap{display:flex;align-items:center;gap:8px;}
.sort-wrap label{font-size:14px;}
.sort-select{padding:6px 10px;border:1px solid #ddd;border-radius:6px;font-size:14px;}
.products-section{padding:25px 0 40px;}
.products-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:20px;}
.product-card{background:#fff;border-radius:10px;overflow:hidden;box-shadow:0 2px 8px rgba(0,0,0,.06);text-decoration:none;transition:transform .2s;display:block;}
.product-card:hover{transform:translateY(-3px);}
.product-img{position:relative;width:100%;height:200px;background:#f9f9f9;overflow:hidden;}
.product-img img{width:100%;height:100%;object-fit:cover;}
.sale-badge{position:absolute;top:8px;left:8px;background:#d32f2f;color:#fff;font-size:12px;font-weight:600;padding:3px 8px;border-radius:4px;}
.product-info{padding:12px;}
.product-info h3{font-size:14px;color:#222;margin-bottom:8px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
.price-row{margin-bottom:4px;}
.current-price{font-size:16px;font-weight:700;color:#d32f2f;}
.old-price{font-size:13px;color:#999;text-decoration:line-through;margin-left:6px;}
.rating{font-size:12px;color:#f57c00;margin-bottom:6px;}
.stock-tag{font-size:12px;font-weight:500;padding:2px 6px;border-radius:4px;display:inline-block;}
.stock-tag.in-stock{background:#e8f5e9;color:#2e7d32;}
.stock-tag.out-stock{background:#fafafa;color:#777;}
.empty-state{grid-column:1/-1;text-align:center;padding:60px 20px;color:#777;}
.pagination-section{padding:20px 0;text-align:center;}
.pagination{display:flex;justify-content:center;align-items:center;gap:15px;}
.page-link{color:#2563eb;text-decoration:none;font-size:14px;font-weight:500;}
.page-info{font-size:14px;color:#777;}
@media (max-width:990px){.products-grid{grid-template-columns:repeat(3,1fr));}}
@media (max-width:768px){
  .products-grid{grid-template-columns:repeat(2,1fr);gap:15px;}
  .collection-title{font-size:22px;}
  .filters-inner{flex-direction:column;align-items:flex-start;}
  .product-img{height:160px;}
}
</style>

<script>
document.addEventListener('DOMContentLoaded',function(){
  const t=document.getElementById('filterToggle'),d=document.getElementById('filtersDropdown');
  t?.addEventListener('click',e=>{e.stopPropagation();d.classList.toggle('active');});
  document.addEventListener('click',e=>{if(!d?.contains(e.target)&&e.target!==t)d?.classList.remove('active');});
});
</script>
