{% comment %}
=== FEATURED COLLECTIONS — FULLY EDITABLE ===
✅ Settings panel included
{% endcomment %}

<div class="featured-collections-section">
  <div class="section-inner">
    <div class="section-header">
      <h2 class="section-title">{{ section.settings.heading }}</h2>
      {% if section.settings.subheading != blank %}
        <p class="section-subtitle">{{ section.settings.subheading }}</p>
      {% endif %}
    </div>

    <div class="collections-grid">
      {% for block in section.blocks %}
        {% if block.type == 'collection_card' %}
          {% assign coll = block.settings.collection %}
          {% if coll %}
            <a href="{{ coll.url }}" class="collection-card">
              <div class="card-image">
                {% if coll.image %}
                  {{ coll.image | image_url: '400x' | image_tag: 'loading', 'lazy' }}
                {% else %}
                  <div class="placeholder-img"></div>
                {% endif %}
              </div>
              <div class="card-info">
                <h3 class="card-title">{{ coll.title }}</h3>
                <p class="card-count">{{ coll.products_count }} products</p>
                <span class="view-link">View Collection →</span>
              </div>
            </a>
          {% endif %}
        {% endif %}
      {% endfor %}
    </div>

    {% if section.settings.show_view_all %}
      <div class="view-all-wrap">
        <a href="/collections/all" class="view-all-btn">View All Collections</a>
      </div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Featured Collections",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop By Category"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": ""
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show 'View All' button",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "collection_card",
      "name": "Collection Card",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Select Collection"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Featured Collections",
      "settings": {
        "heading": "Shop By Category",
        "show_view_all": true
      },
      "blocks": [
        { "type": "collection_card" },
        { "type": "collection_card" },
        { "type": "collection_card" },
        { "type": "collection_card" }
      ]
    }
  ]
}
{% endschema %}

<style>
*{margin:0;padding:0;box-sizing:border-box;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif;}
.featured-collections-section{width:100%;max-width:1200px;margin:0 auto;padding:50px 15px;}
.section-header{text-align:center;margin-bottom:35px;}
.section-title{font-size:22px;font-weight:700;color:#111;margin-bottom:6px;}
.section-subtitle{font-size:14px;color:#666;}
.collections-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:20px;}
.collection-card{background:#fff;border-radius:12px;overflow:hidden;box-shadow:0 2px 8px rgba(0,0,0,.06);text-decoration:none;transition:transform .2s;display:block;}
.collection-card:hover{transform:translateY(-4px);box-shadow:0 6px 16px rgba(0,0,0,.1);}
.card-image{width:100%;height:160px;background:#f5f5f5;overflow:hidden;}
.card-image img{width:100%;height:100%;object-fit:cover;}
.placeholder-img{width:100%;height:100%;background:linear-gradient(135deg,#e9e5e0,#e0e9e5);}
.card-info{padding:15px;}
.card-title{font-size:15px;font-weight:600;color:#111;margin-bottom:4px;}
.card-count{font-size:13px;color:#777;margin-bottom:8px;}
.view-link{font-size:14px;color:#2563eb;font-weight:500;}
.view-all-wrap{text-align:center;margin-top:30px;}
.view-all-btn{background:#2563eb;color:#fff;padding:10px 24px;border-radius:6px;text-decoration:none;font-weight:500;display:inline-block;transition:opacity .2s;}
.view-all-btn:hover{opacity:.9;}
@media (max-width:990px){.collections-grid{grid-template-columns:repeat(3,1fr);}}
@media (max-width:768px){
  .collections-grid{grid-template-columns:repeat(2,1fr);gap:15px;}
  .section-title{font-size:20px;}
  .card-image{height:130px;}
}
</style>
