{% comment %}
✅ FEATURED PRODUCTS — FINAL • SCHEMA FIXED
✅ "product_limit" default = 16 — NO QUOTES = VALID
✅ Matches your preview: clean cards, no filters
{% endcomment %}

{% schema %}
{
  "name": "Featured Products",
  "settings": [
    {
      "type": "text",
      "id": "section_title",
      "label": "Section Title",
      "default": "Featured Products"
    },
    {
      "type": "collection",
      "id": "featured_collection",
      "label": "Select Collection to Show",
      "info": "Leave empty to show all products"
    },
    {
      "type": "number",
      "id": "product_limit",
      "label": "Number of Products to Show",
      "default": 16,
      "info": "Choose between 4–24 products"
    },
    {
      "type": "select",
      "id": "grid_style",
      "label": "Grid Layout Style",
      "default": "four",
      "options": [
        {"value": "three", "label": "3 per row (Large cards)"},
        {"value": "four", "label": "4 per row (Standard — as preview)"},
        {"value": "five", "label": "5 per row (Compact)"},
        {"value": "six", "label": "6 per row (Smallest)"}
      ]
    }
  ],
  "presets": [{"name": "Featured Products"}]
}
{% endschema %}

<section class="featured-section">
  <div class="container">
    <h2>{{ section.settings.section_title | escape }}</h2>

    {% if section.settings.grid_style == "three" %}
      {% assign cols = "three-col" %}
    {% elsif section.settings.grid_style == "four" %}
      {% assign cols = "four-col" %}
    {% elsif section.settings.grid_style == "five" %}
      {% assign cols = "five-col" %}
    {% elsif section.settings.grid_style == "six" %}
      {% assign cols = "six-col" %}
    {% else %}
      {% assign cols = "four-col" %}
    {% endif %}

    <div class="product-grid-small {{ cols }}">
      {% if section.settings.featured_collection %}
        {% assign products = collections[section.settings.featured_collection].products | limit: section.settings.product_limit %}
      {% else %}
        {% assign products = collections.all.products | limit: section.settings.product_limit %}
      {% endif %}

      {% for product in products %}
        <div class="product-card-compact">
          <a href="{{ product.url | escape }}">
            <img src="{{ product.featured_image | image_url: '350x350' }}" alt="{{ product.title | escape }}" loading="lazy">
            <h3>{{ product.title | escape | truncate: 24 }}</h3>
            <p class="price">{{ product.price | money }}</p>
          </a>
        </div>
      {% endfor %}
    </div>
  </div>
</section>