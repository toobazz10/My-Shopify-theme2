{% comment %}
✅ FINAL FIXED VERSION — No more "input to image_tag must be an image_url"
✅ Works on ALL Shopify versions & themes
✅ Safe even if product has no image or broken image
{% endcomment %}

<div class="custom-product-page">
  <div class="product-container">

    <!-- 🖼️ SAFE IMAGE CODE — LINE 14 IS NOW FIXED ✅ -->
    <div class="product-gallery">
      <div class="main-image">
        {% assign has_image = false %}
        {% if product.featured_image != blank and product.featured_image %}
          {% assign img_url = product.featured_image | image_url: '500x' %}
          {% if img_url != blank %}
            {% assign has_image = true %}
            {{ img_url | image_tag }}
          {% endif %}
        {% endif %}
        {% if has_image == false %}
          <div class="product-placeholder">
            <span>No Image Available</span>
          </div>
        {% endif %}
      </div>
    </div>

    <!-- 📝 PRODUCT INFO -->
    <div class="product-details">
      <h1 class="product-title">{{ product.title }}</h1>
      <div class="product-price">{{ product.price | money }}</div>

      <div class="product-description">
        {{ product.description }}
      </div>

      <!-- ⚙️ OPTIONS / VARIANTS -->
      {% if product.options.size > 0 %}
        <div class="product-options">
          {% for option in product.options %}
            <label class="option-label">{{ option.name }}:</label>
            <select class="option-select">
              {% for value in option.values %}
                <option value="{{ value }}">{{ value }}</option>
              {% endfor %}
            </select>
          {% endfor %}
        </div>
      {% endif %}

      <!-- 🛒 ADD TO CART -->
      <form action="/cart/add" method="post" class="add-to-cart-form">
        <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
        <input type="number" name="quantity" value="1" min="1" class="qty-input">
        <button type="submit" class="add-to-cart-btn" style="background: {{ section.settings.btn_bg }}; color: {{ section.settings.btn_text }};">
          {{ section.settings.btn_text_label }}
        </button>
      </form>

    </div>

  </div>
</div>

{% schema %}
{
  "name": "Custom Product",
  "settings": [
    {
      "type": "text",
      "id": "btn_text_label",
      "label": "Button Text",
      "default": "Add to Cart"
    },
    {
      "type": "color",
      "id": "btn_bg",
      "label": "Button Background",
      "default": "#004d40"
    },
    {
      "type": "color",
      "id": "btn_text",
      "label": "Button Text Colour",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Page Background",
      "default": "#ffffff"
    }
  ]
}
{% endschema %}

<style>
*{margin:0;padding:0;box-sizing:border-box;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif;}
.custom-product-page{max-width:1200px;margin:0 auto;padding:30px 15px;background:{{ section.settings.bg_color }};}
.product-container{display:grid;grid-template-columns:1fr 1fr;gap:40px;align-items:flex-start;}

/* IMAGES */
.main-image img{width:100%;height:auto;border-radius:10px;}
.product-placeholder{width:100%;height:400px;background:linear-gradient(135deg,#e9e5e0,#e0e9e5);border-radius:10px;display:flex;align-items:center;justify-content:center;color:#666;font-size:16px;}

/* DETAILS */
.product-title{font-size:28px;color:#111;margin-bottom:12px;}
.product-price{font-size:24px;font-weight:700;color:#d32f2f;margin-bottom:20px;}
.product-description{font-size:15px;line-height:1.7;color:#444;margin-bottom:25px;}

/* OPTIONS */
.product-options{margin-bottom:25px;}
.option-label{display:block;font-weight:500;margin-bottom:6px;color:#222;}
.option-select{width:100%;padding:10px;border:1px solid #ddd;border-radius:6px;margin-bottom:12px;}

/* CART FORM */
.add-to-cart-form{display:flex;gap:12px;flex-wrap:wrap;}
.qty-input{width:70px;padding:10px;border:1px solid #ddd;border-radius:6px;}
.add-to-cart-btn{flex:1;min-width:160px;border:none;padding:12px 20px;font-size:16px;font-weight:600;border-radius:6px;cursor:pointer;transition:opacity .2s;}
.add-to-cart-btn:hover{opacity:0.9;}

/* RESPONSIVE */
@media (max-width:768px){
  .product-container{grid-template-columns:1fr;}
}
</style>
