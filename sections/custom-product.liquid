{% comment %}
=== CUSTOM PRODUCT PAGE — FULLY EDITABLE ===
✅ Colours · Labels · Layout · All editable
{% endcomment %}

<div class="custom-product-page" style="background: {{ section.settings.page_bg }};">
  <div class="product-page-inner">
    <div class="product-gallery">
      <div class="main-img">{{ product.selected_or_first_available_variant.image | image_url: '1024x' | image_tag }}</div>
      {% if product.images.size > 1 %}
      <div class="thumbnails">
        {% for image in product.images %}<div class="thumb">{{ image | image_url: '100x' | image_tag }}</div>{% endfor %}
      </div>
      {% endif %}
    </div>

    <div class="product-details">
      <h1 class="product-name" style="color: {{ section.settings.heading_color }};">
        {{ product.title }}
      </h1>
      <div class="price-box">
        {% if product.compare_at_price > product.price %}
          <span class="current-price">{{ product.price | money }}</span>
          <span class="old-price">{{ product.compare_at_price | money }}</span>
        {% else %}
          <span class="current-price">{{ product.price | money }}</span>
        {% endif %}
      </div>
      <div class="stock-status">
        {% if product.available %}
          <span class="in-stock" style="color: {{ section.settings.instock_color }};">
            ✅ {{ section.settings.instock_text }}
          </span>
        {% else %}
          <span class="out-stock" style="color: {{ section.settings.outstock_color }};">
            ❌ {{ section.settings.outstock_text }}
          </span>
        {% endif %}
      </div>

      {% if product.has_only_default_variant == false %}
      <div class="product-variants">
        {% for option in product.options_with_values %}
          <label class="option-label">{{ option.name }}</label>
          <div class="option-values">
            {% for value in option.values %}<button class="option-btn">{{ value }}</button>{% endfor %}
          </div>
        {% endfor %}
      </div>
      {% endif %}

      <div class="purchase-area">
        <div class="qty-wrap">
          <button class="qty-minus">-</button>
          <input type="number" class="qty-input" value="1" min="1">
          <button class="qty-plus">+</button>
        </div>
        <form action="/cart/add" method="post" class="add-form">
          <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
          <input type="hidden" name="quantity" value="1" class="qty-val">
          <button type="submit" class="add-btn" style="background: {{ section.settings.addcart_bg }}; color: {{ section.settings.addcart_text }};">
            {{ section.settings.addcart_label }}
          </button>
          <button type="submit" class="buy-btn" formaction="/checkout" style="background: {{ section.settings.buynow_bg }}; color: {{ section.settings.buynow_text }};">
            {{ section.settings.buynow_label }}
          </button>
        </form>
      </div>

      <div class="product-desc" style="color: {{ section.settings.text_color }};">
        <h3 style="color: {{ section.settings.heading_color }};">Description</h3>
        {{ product.description }}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Custom Product",
  "settings": [
    {
      "type": "header",
      "content": "🎨 Colours"
    },
    {
      "type": "color",
      "id": "page_bg",
      "label": "Page Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Headings Colour",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Description Text Colour",
      "default": "#333333"
    },
    {
      "type": "color",
      "id": "instock_color",
      "label": "In Stock Text Colour",
      "default": "#2e7d32"
    },
    {
      "type": "color",
      "id": "outstock_color",
      "label": "Out of Stock Text Colour",
      "default": "#d32f2f"
    },
    {
      "type": "header",
      "content": "🏷️ Button Labels & Colours"
    },
    {
      "type": "text",
      "id": "instock_text",
      "label": "In Stock Message",
      "default": "In Stock — Free UK Delivery"
    },
    {
      "type": "text",
      "id": "outstock_text",
      "label": "Out of Stock Message",
      "default": "Out of Stock"
    },
    {
      "type": "text",
      "id": "addcart_label",
      "label": "Add to Cart Button Text",
      "default": "🛒 Add to Cart"
    },
    {
      "type": "color",
      "id": "addcart_bg",
      "label": "Add to Cart Background",
      "default": "#2563eb"
    },
    {
      "type": "color",
      "id": "addcart_text",
      "label": "Add to Cart Text Colour",
      "default": "#ffffff"
    },
    {
      "type": "text",
      "id": "buynow_label",
      "label": "Buy Now Button Text",
      "default": "⚡ Buy Now"
    },
    {
      "type": "color",
      "id": "buynow_bg",
      "label": "Buy Now Background",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "buynow_text",
      "label": "Buy Now Text Colour",
      "default": "#ffffff"
    }
  ],
  "presets": [
    {
      "name": "Custom Product",
      "settings": {}
    }
  ]
}
{% endschema %}

<style>
*{margin:0;padding:0;box-sizing:border-box;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif;}
.custom-product-page{max-width:1200px;margin:0 auto;padding:15px;}
.product-page-inner{display:grid;grid-template-columns:1fr 1fr;gap:30px;}
.product-gallery .main-img img{width:100%;height:auto;border-radius:12px;object-fit:cover;}
.thumbnails{display:flex;gap:10px;margin-top:12px;overflow-x:auto;}
.thumb{width:70px;height:70px;border-radius:6px;cursor:pointer;overflow:hidden;}
.thumb img{width:100%;height:100%;object-fit:cover;}
.product-name{font-size:26px;margin-bottom:12px;line-height:1.3;}
.price-box{font-size:24px;font-weight:700;color:#d32f2f;margin-bottom:10px;}
.old-price{font-size:18px;color:#888;text-decoration:line-through;margin-left:10px;font-weight:400;}
.stock-status{font-size:15px;margin-bottom:20px;}
.option-label{font-size:15px;font-weight:600;margin:15px 0 8px;display:block;}
.option-values{display:flex;gap:8px;flex-wrap:wrap;}
.option-btn{padding:8px 14px;border:1px solid #ddd;background:#fff;border-radius:6px;cursor:pointer;transition:all .2s;}
.option-btn:hover{border-color:#2563eb;background:#eff6ff;}
.purchase-area{margin:25px 0;}
.qty-wrap{display:flex;align-items:center;border:1px solid #ddd;border-radius:6px;width:130px;margin-bottom:15px;}
.qty-minus,.qty-plus{background:#f5f5f5;border:none;padding:10px 14px;cursor:pointer;font-size:16px;}
.qty-input{width:40px;text-align:center;border:none;outline:none;font-size:16px;}
.add-form{display:flex;flex-direction:column;gap:10px;}
.add-btn,.buy-btn{padding:14px 20px;border:none;border-radius:8px;font-size:17px;font-weight:600;cursor:pointer;transition:opacity .2s;}
.add-btn:hover,.buy-btn:hover{opacity:.9;}
.product-desc{margin-top:30px;line-height:1.6;}
.product-desc h3{font-size:18px;margin-bottom:10px;}
@media (max-width:768px){
  .product-page-inner{grid-template-columns:1fr;gap:20px;}
  .product-name{font-size:22px;}
  .add-btn,.buy-btn{width:100%;}
}
</style>

<script>
document.addEventListener('DOMContentLoaded',function(){
  const m=document.querySelector('.qty-minus'),p=document.querySelector('.qty-plus'),i=document.querySelector('.qty-input'),v=document.querySelector('.qty-val');
  m?.addEventListener('click',()=>{if(i.value>1){i.value=parseInt(i.value)-1;v.value=i.value;}});
  p?.addEventListener('click',()=>{i.value=parseInt(i.value)+1;v.value=i.value;});
  i?.addEventListener('change',()=>{v.value=i.value;});
});
</script>
