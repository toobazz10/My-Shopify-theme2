{% comment %}
  File MUST be named: sections/header.liquid
  Mega Menu • Search • Login/Account
{% endcomment %}

{% schema %}
{
  "name": "Header",
  "tag": "header",
  "class": "site-header",
  "limit": 1,
  "settings": [
    {
      "type": "text",
      "id": "logo_text",
      "label": "Logo Text",
      "default": "Siench"
    },
    {
      "type": "link_list",
      "id": "main_menu",
      "label": "Main Menu"
    },
    {
      "type": "checkbox",
      "id": "show_search",
      "label": "Show Search Bar",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_account",
      "label": "Show Login/Account",
      "default": true
    }
  ],
  "presets": [{"name": "Header"}]
}
{% endschema %}

<div class="container header-wrapper">

  <!-- LOGO -->
  <a href="{{ routes.root_url }}" class="site-logo" aria-label="{{ shop.name | escape }}">
    {{ section.settings.logo_text | escape }}
  </a>

  <!-- MEGA MENU -->
  <nav class="main-nav" role="navigation" aria-label="Main Menu">
    {% assign main_menu = linklists[section.settings.main_menu.handle] %}
    {% if main_menu.links.size > 0 %}
      <ul class="menu-list">
        {% for link in main_menu.links %}
          <li class="menu-item{% if link.links.size > 0 %} has-mega-menu{% endif %}">
            <a href="{{ link.url | escape }}" class="menu-link">
              {{ link.title | escape }}
            </a>
            {% if link.links.size > 0 %}
              <div class="mega-menu">
                <ul class="mega-menu-grid">
                  {% for sublink in link.links %}
                    <li class="mega-col">
                      <a href="{{ sublink.url | escape }}" class="mega-link">{{ sublink.title | escape }}</a>
                      {% if sublink.links.size > 0 %}
                        <ul class="mega-sublinks">
                          {% for child in sublink.links %}
                            <li><a href="{{ child.url | escape }}" class="mega-sub-link">{{ child.title | escape }}</a></li>
                          {% endfor %}
                        </ul>
                      {% endif %}
                    </li>
                  {% endfor %}
                </ul>
              </div>
            {% endif %}
          </li>
        {% endfor %}
      </ul>
    {% endif %}
  </nav>

  <!-- ✅ SEARCH — PERFECT SHOPIFY FORMAT -->
  {% if section.settings.show_search %}
    <div class="search-container">
      <form action="{{ routes.search_url }}" method="get" class="search-form" role="search">
        <input type="text" name="q" placeholder="Search products..." class="search-input" autocomplete="off">
        <button type="submit" class="search-btn">🔍</button>
      </form>
    </div>
  {% endif %}

  <!-- ✅ ACCOUNT / LOGIN — CORRECT ROUTES -->
  {% if section.settings.show_account %}
    <div class="account-links">
      {% if customer %}
        <a href="{{ routes.account_url }}" class="account-link">My Account</a>
        <a href="{{ routes.logout_url }}" class="account-link">Logout</a>
      {% else %}
        <a href="{{ routes.login_url }}" class="account-link">Login</a>
        <a href="{{ routes.register_url }}" class="account-link">Register</a>
      {% endif %}
    </div>
  {% endif %}

</div>