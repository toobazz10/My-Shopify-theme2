{% comment %}
=== CUSTOM HEADER ===
Sticky · Mobile menu · Cart counter
{% endcomment %}

<header class="custom-header">
  <div class="header-container">
    <a href="/" class="logo-link">
      <span class="logo-text">YOUR STORE</span>
    </a>

    <nav class="desktop-nav">
      <a href="/" class="nav-link">Home</a>
      <a href="/collections/all" class="nav-link">Shop</a>
      <a href="/pages/about" class="nav-link">About</a>
      <a href="/pages/contact" class="nav-link">Contact</a>
    </nav>

    <div class="header-icons">
      <a href="/search" class="icon-btn">🔍</a>
      <a href="/account" class="icon-btn">👤</a>
      <a href="/cart" class="icon-btn cart-icon">
        🛒
        <span class="cart-count">{{ cart.item_count }}</span>
      </a>
      <button class="menu-toggle" id="menuToggle">☰</button>
    </div>
  </div>

  <div class="mobile-menu" id="mobileMenu">
    <a href="/" class="mobile-link">Home</a>
    <a href="/collections/all" class="mobile-link">Shop</a>
    <a href="/pages/about" class="mobile-link">About</a>
    <a href="/pages/contact" class="mobile-link">Contact</a>
  </div>
</header>

<style>
* {margin:0;padding:0;box-sizing:border-box;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif;}
.custom-header{background:#fff;border-bottom:1px solid #eee;position:sticky;top:0;z-index:999;}
.header-container{max-width:1200px;margin:0 auto;padding:12px 15px;display:flex;align-items:center;justify-content:space-between;}
.logo-link{text-decoration:none;}
.logo-text{font-size:20px;font-weight:700;color:#111;}
.desktop-nav{display:flex;gap:28px;}
.nav-link{text-decoration:none;color:#333;font-size:15px;font-weight:500;transition:color .2s;}
.nav-link:hover{color:#2563eb;}
.header-icons{display:flex;align-items:center;gap:16px;}
.icon-btn{font-size:20px;text-decoration:none;color:#333;position:relative;}
.cart-count{position:absolute;top:-8px;right:-8px;background:#d32f2f;color:#fff;font-size:11px;min-width:16px;height:16px;border-radius:50%;display:flex;align-items:center;justify-content:center;}
.menu-toggle{display:none;background:none;border:none;font-size:24px;cursor:pointer;color:#333;}
.mobile-menu{display:none;flex-direction:column;background:#fff;border-top:1px solid #eee;padding:10px 0;}
.mobile-link{padding:12px 20px;text-decoration:none;color:#333;font-size:15px;border-bottom:1px solid #f5f5f5;}
@media (max-width:768px){
  .desktop-nav{display:none;}
  .menu-toggle{display:block;}
  .mobile-menu.active{display:flex;}
}
</style>

<script>
document.addEventListener('DOMContentLoaded',function(){
  const t=document.getElementById('menuToggle'),m=document.getElementById('mobileMenu');
  t?.addEventListener('click',()=>m.classList.toggle('active'));
});
</script>
