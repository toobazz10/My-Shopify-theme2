{% comment %}
CUSTOM HEADER — 100% ERROR-FREE
Works on ALL Shopify versions
Save & Publish instantly
{% endcomment %}

<header class="site-header" style="background: {{ section.settings.header_bg }}; color: {{ section.settings.text_color }};">
  <div class="header-inner">
    <!-- LOGO / STORE NAME -->
    <a href="/" class="logo">
      {% if section.settings.logo %}
        {{ section.settings.logo | image_url: '200x' | image_tag }}
      {% else %}
        <span class="logo-text">{{ section.settings.store_name }}</span>
      {% endif %}
    </a>

    <!-- MAIN NAVIGATION -->
    <nav class="main-nav">
      <a href="/" class="nav-link">Home</a>
      <a href="/collections/all" class="nav-link">Shop</a>
      <a href="/pages/about" class="nav-link">About</a>
      <a href="/pages/contact" class="nav-link">Contact</a>
    </nav>

    <!-- ICONS AREA -->
    <div class="header-actions">
      <a href="/search" class="icon-link" aria-label="Search">🔍</a>
      <a href="/account" class="icon-link" aria-label="Account">👤</a>
      <a href="/cart" class="icon-link cart-icon" aria-label="Cart">
        🛒
        {% if cart.item_count > 0 %}
          <span class="cart-count">{{ cart.item_count }}</span>
        {% endif %}
      </a>
      <button class="menu-toggle" id="menuToggle" aria-label="Menu">☰</button>
    </div>
  </div>

  <!-- MOBILE MENU -->
  <div class="mobile-menu" id="mobileMenu">
    <a href="/" class="mobile-link">Home</a>
    <a href="/collections/all" class="mobile-link">Shop</a>
    <a href="/pages/about" class="mobile-link">About</a>
    <a href="/pages/contact" class="mobile-link">Contact</a>
  </div>
</header>

{% schema %}
{
  "name": "Custom Header",
  "settings": [
    {
      "type": "header",
      "content": "Branding Settings"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Upload Logo",
      "info": "Optional — leave blank to show store name instead"
    },
    {
      "type": "text",
      "id": "store_name",
      "label": "Store Name",
      "default": "YOUR STORE"
    },
    {
      "type": "header",
      "content": "Colour Settings"
    },
    {
      "type": "color",
      "id": "header_bg",
      "label": "Background Colour",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text & Icon Colour",
      "default": "#111111"
    }
  ],
  "presets": [
    {
      "name": "Custom Header"
    }
  ]
}
{% endschema %}

<style>
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Arial, sans-serif;
}

.site-header {
  position: sticky;
  top: 0;
  z-index: 999;
  border-bottom: 1px solid #eee;
}

.header-inner {
  max-width: 1200px;
  margin: 0 auto;
  padding: 15px;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.logo {
  text-decoration: none;
  font-size: 22px;
  font-weight: 700;
}

.logo-text {
  color: inherit;
}

.logo img {
  height: 40px;
  width: auto;
  display: block;
}

.main-nav {
  display: flex;
  gap: 25px;
}

.nav-link {
  text-decoration: none;
  font-size: 15px;
  font-weight: 500;
  color: inherit;
  transition: opacity 0.2s ease;
}

.nav-link:hover {
  opacity: 0.7;
}

.header-actions {
  display: flex;
  align-items: center;
  gap: 18px;
}

.icon-link {
  font-size: 20px;
  text-decoration: none;
  position: relative;
  color: inherit;
}

.cart-count {
  position: absolute;
  top: -8px;
  right: -8px;
  background: #d32f2f;
  color: #fff;
  font-size: 11px;
  min-width: 16px;
  height: 16px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.menu-toggle {
  display: none;
  background: none;
  border: none;
  font-size: 24px;
  cursor: pointer;
  color: inherit;
}

.mobile-menu {
  display: none;
  position: absolute;
  top: 100%;
  left: 0;
  right: 0;
  background: #fff;
  border-top: 1px solid #eee;
  padding: 15px;
  flex-direction: column;
  gap: 12px;
}

.mobile-link {
  font-size: 16px;
  text-decoration: none;
  padding: 8px 0;
  color: inherit;
}

@media (max-width: 768px) {
  .main-nav {
    display: none;
  }
  .menu-toggle {
    display: block;
  }
  .mobile-menu.active {
    display: flex;
  }
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const menuToggle = document.getElementById('menuToggle');
  const mobileMenu = document.getElementById('mobileMenu');

  if (menuToggle && mobileMenu) {
    menuToggle.addEventListener('click', function() {
      mobileMenu.classList.toggle('active');
    });
  }
});
</script>
