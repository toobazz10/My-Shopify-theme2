{% schema %}
{
  "name": "Flash Sale Banner",
  "settings": [
    {"type": "image_picker", "id": "banner_image", "label": "Banner Image"},
    {"type": "text", "id": "heading", "label": "Heading", "default": "FLASH SALE"},
    {"type": "text", "id": "subheading", "label": "Subheading", "default": "Up to 70% OFF — Limited Time Only"}
  ]
}
{% endschema %}

<section class="banner-section">
  <div class="banner-wrapper" style="background-image: url('{{ settings.banner_image | image_url: '1920x600' }}');">
    <div class="banner-content">
      <h1>{{ settings.heading | escape }}</h1>
      <p>{{ settings.subheading | escape }}</p>
      <a href="/collections/all" class="btn btn-primary">Shop Now</a>
    </div>
  </div>
</section>