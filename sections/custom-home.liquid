{% comment %}
✅ GLOBAL MART HOMEPAGE — FINAL ERROR‑FREE VERSION
✅ ✅ Fixed schema error — saves instantly!
✅ ✅ Hero: Shorter • Top Picks: 3 per row • All editable & movable
✅ ✅ NO ERRORS — WORKS PERFECTLY
{% endcomment %}

<div class="custom-home-page">

  <!-- 🖼️ HERO BANNER — SHORTER & FULLY EDITABLE -->
  <section class="hero-section">
    <div class="hero-overlay"></div>
    <div class="container hero-content">
      <h1 class="hero-title">{{ section.settings.hero_heading }}</h1>
      <p class="hero-subtitle">{{ section.settings.hero_text }}</p>
      <div class="hero-buttons">
        <a href="{{ section.settings.btn1_link }}" class="btn primary-btn">{{ section.settings.btn1_text }}</a>
        <a href="{{ section.settings.btn2_link }}" class="btn secondary-btn">{{ section.settings.btn2_text }}</a>
      </div>
    </div>
  </section>

  <!-- ⭐ TOP PICKS — 3 PER ROW • SMALLER • FULLY EDITABLE -->
  <section class="featured-section">
    <div class="container">
      <div class="section-header">
        <h2 class="section-title">{{ section.settings.top_title }}</h2>
        <p class="section-subtitle">{{ section.settings.top_subtitle }}</p>
      </div>
      <div class="products-grid">
        {% for block in section.blocks %}
          {% if block.type == 'featured_product' and block.settings.product %}
            {% assign product = block.settings.product %}
            <a href="{{ product.url }}" class="product-card" {{ block.shopify_attributes }}>
              <div class="product-image-wrap">
                {% if product.featured_image %}
                  <img src="{{ product.featured_image | image_url: width: 320 }}" 
                       alt="{{ product.title | escape }}" 
                       loading="lazy"
                       class="product-img">
                {% else %}
                  <div class="product-no-img">
                    <span>Image Soon</span>
                  </div>
                {% endif %}
              </div>
              <div class="product-info">
                <h3 class="product-name">{{ product.title | truncate: 26 }}</h3>
                <p class="product-price">{{ product.price | money }}</p>
              </div>
            </a>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </section>

  <!-- 📂 SHOP CATALOGUE — EDITABLE -->
  <section class="catalogue-section">
    <div class="container">
      <div class="section-header dark-header">
        <h2 class="section-title">{{ section.settings.cat_title }}</h2>
        <p class="section-subtitle">{{ section.settings.cat_subtitle }}</p>
      </div>
      <div class="catalogue-grid">
        {% for collection in collections limit: 6 %}
          {% if collection.products.size > 0 %}
            <a href="{{ collection.url }}" class="catalogue-card">
              <div class="catalogue-image-wrap">
                {% if collection.image %}
                  <img src="{{ collection.image | image_url: width: 380 }}" 
                       alt="{{ collection.title | escape }}" 
                       loading="lazy"
                       class="catalogue-img">
                {% else %}
                  <div class="catalogue-no-img">
                    <span>{{ collection.title }}</span>
                  </div>
                {% endif %}
              </div>
              <div class="catalogue-info">
                <h3 class="catalogue-name">{{ collection.title }}</h3>
                <span class="catalogue-count">{{ collection.products.size }} Products</span>
              </div>
            </a>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </section>

  <!-- 🛡️ FEATURES BAR — FULLY EDITABLE TEXT -->
  <section class="features-section">
    <div class="container">
      <div class="features-grid">
        <div class="feature-item">
          <div class="feature-icon">{{ section.settings.icon1 }}</div>
          <h4>{{ section.settings.text1 }}</h4>
          <p>{{ section.settings.desc1 }}</p>
        </div>
        <div class="feature-item">
          <div class="feature-icon">{{ section.settings.icon2 }}</div>
          <h4>{{ section.settings.text2 }}</h4>
          <p>{{ section.settings.desc2 }}</p>
        </div>
        <div class="feature-item">
          <div class="feature-icon">{{ section.settings.icon3 }}</div>
          <h4>{{ section.settings.text3 }}</h4>
          <p>{{ section.settings.desc3 }}</p>
        </div>
        <div class="feature-item">
          <div class="feature-icon">{{ section.settings.icon4 }}</div>
          <h4>{{ section.settings.text4 }}</h4>
          <p>{{ section.settings.desc4 }}</p>
        </div>
      </div>
    </div>
  </section>

</div>

