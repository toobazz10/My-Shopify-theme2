{% comment %}
✅ GLOBAL MART HOMEPAGE — PREMIUM PROFESSIONAL VERSION
✅ Elegant design · Smooth animations · Modern layout
✅ YOU SELECT TOP PICKS IN CUSTOMIZE · 100% ERROR‑FREE
✅ Fully responsive · Fast loading · Brand‑aligned
{% endcomment %}

<div class="custom-home-page">

  <!-- 🖼️ HERO SECTION — PREMIUM BANNER -->
  <section class="hero-section">
    <div class="hero-overlay"></div>
    <div class="container hero-content">
      <h1 class="hero-title">Global Mart</h1>
      <p class="hero-subtitle">Curated Quality · Fast UK Delivery · Unbeatable Value</p>
      <div class="hero-buttons">
        <a href="/collections/all" class="btn primary-btn">Shop Now</a>
        <a href="/pages/about" class="btn secondary-btn">Learn More</a>
      </div>
    </div>
  </section>

  <!-- ⭐ TOP PICKS — YOU CHOOSE IN CUSTOMIZE -->
  <section class="featured-section">
    <div class="container">
      <div class="section-header">
        <h2 class="section-title">Top Picks</h2>
        <p class="section-subtitle">Hand‑picked favourites just for you</p>
      </div>
      <div class="products-grid">
        {% for block in section.blocks %}
          {% if block.type == 'featured_product' and block.settings.product %}
            {% assign product = block.settings.product %}
            <a href="{{ product.url }}" class="product-card" {{ block.shopify_attributes }}>
              <div class="product-image-wrap">
                {% if product.featured_image %}
                  <img src="{{ product.featured_image | image_url: width: 500 }}" 
                       alt="{{ product.title | escape }}" 
                       loading="lazy"
                       class="product-img">
                {% else %}
                  <div class="product-no-img">
                    <span>Image Soon</span>
                  </div>
                {% endif %}
                <div class="product-badge">Featured</div>
              </div>
              <div class="product-info">
                <h3 class="product-name">{{ product.title | truncate: 32 }}</h3>
                <p class="product-price">{{ product.price | money }}</p>
                <span class="product-link">View Details →</span>
              </div>
            </a>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </section>

  <!-- 📂 SHOP MY CATALOGUE — ELEGANT CATEGORIES -->
  <section class="catalogue-section">
    <div class="container">
      <div class="section-header dark-header">
        <h2 class="section-title">Shop My Catalogue</h2>
        <p class="section-subtitle">Explore our wide range of premium collections</p>
      </div>
      <div class="catalogue-grid">
        {% for collection in collections limit: 6 %}
          {% if collection.products.size > 0 %}
            <a href="{{ collection.url }}" class="catalogue-card">
              <div class="catalogue-image-wrap">
                {% if collection.image %}
                  <img src="{{ collection.image | image_url: width: 500 }}" 
                       alt="{{ collection.title | escape }}" 
                       loading="lazy"
                       class="catalogue-img">
                {% else %}
                  <div class="catalogue-no-img">
                    <span>{{ collection.title }}</span>
                  </div>
                {% endif %}
              </div>
              <div class="catalogue-info">
                <h3 class="catalogue-name">{{ collection.title }}</h3>
                <span class="catalogue-count">{{ collection.products.size }} Products</span>
              </div>
            </a>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </section>

  <!-- 🛡️ TRUST & FEATURES — PROFESSIONAL BAR -->
  <section class="features-section">
    <div class="container">
      <div class="features-grid">
        <div class="feature-item">
          <div class="feature-icon">🔒</div>
          <h4>Secure Checkout</h4>
          <p>Encrypted payments & safe shopping</p>
        </div>
        <div class="feature-item">
          <div class="feature-icon">🚚</div>
          <h4>Fast UK Delivery</h4>
          <p>Tracked & quick dispatch nationwide</p>
        </div>
        <div class="feature-item">
          <div class="feature-icon">✅</div>
          <h4>Quality Guaranteed</h4>
          <p>Carefully selected items only</p>
        </div>
        <div class="feature-item">
          <div class="feature-icon">💬</div>
          <h4>Dedicated Support</h4>
          <p>Here to help whenever you need</p>
        </div>
      </div>
    </div>
  </section>

</div>

{% schema %}
{
  "name": "Global Mart Homepage",
  "settings": [
    {
      "type": "header",
      "content": "🎨 BRAND STYLING"
    },
    {
      "type": "color",
      "id": "hero_bg",
      "label": "Hero Background",
      "default": "#004d40"
    },
    {
      "type": "color",
      "id": "hero_text",
      "label": "Hero Text Colour",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "primary",
      "label": "Main Brand Colour",
      "default": "#00695c"
    },
    {
      "type": "color",
      "id": "accent",
      "label": "Accent / Highlight Colour",
      "default": "#ff8f00"
    },
    {
      "type": "color",
      "id": "text_dark",
      "label": "Heading Text",
      "default": "#1e293b"
    },
    {
      "type": "color",
      "id": "text_light",
      "label": "Body Text",
      "default": "#64748b"
    },
    {
      "type": "color",
      "id": "price_col",
      "label": "Price Colour",
      "default": "#d32f2f"
    }
  ],
  "blocks": [
    {
      "type": "featured_product",
      "name": "Selected Product",
      "limit": 8,
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Choose Product",
          "info": "Pick any product to feature in Top Picks"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Homepage",
      "category": "Home"
    }
  ]
}
{% endschema %}

<style>
/* === BASE STYLES === */
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
}
body {
  line-height: 1.6;
  color: #334155;
  overflow-x: hidden;
}
.container {
  max-width: 1240px;
  width: 100%;
  margin: 0 auto;
  padding: 0 20px;
}
a {
  text-decoration: none;
  transition: all 0.3s ease;
}

/* === HERO SECTION — LUXURY BANNER === */
.hero-section {
  position: relative;
  background: {{ section.settings.hero_bg }};
  padding: 100px 20px;
  overflow: hidden;
}
.hero-overlay {
  position: absolute;
  inset: 0;
  background: radial-gradient(circle at 20% 50%, rgba(255,255,255,0.08), transparent 50%),
              radial-gradient(circle at 80% 80%, rgba(255,255,255,0.05), transparent 40%);
  pointer-events: none;
}
.hero-content {
  position: relative;
  text-align: center;
  color: {{ section.settings.hero_text }};
}
.hero-title {
  font-size: clamp(2.8rem, 6vw, 4.2rem);
  font-weight: 800;
  letter-spacing: -0.5px;
  margin-bottom: 12px;
}
.hero-subtitle {
  font-size: clamp(1.1rem, 2.5vw, 1.4rem);
  opacity: 0.88;
  max-width: 600px;
  margin: 0 auto 36px;
}
.hero-buttons {
  display: flex;
  gap: 16px;
  justify-content: center;
  flex-wrap: wrap;
}
.btn {
  padding: 14px 32px;
  border-radius: 10px;
  font-weight: 600;
  font-size: 1rem;
  border: none;
  cursor: pointer;
  transition: all 0.3s ease;
}
.primary-btn {
  background: {{ section.settings.accent }};
  color: #fff;
  box-shadow: 0 4px 12px rgba(255,143,0,0.25);
}
.primary-btn:hover {
  transform: translateY(-2px);
  box-shadow: 0 6px 20px rgba(255,143,0,0.35);
}
.secondary-btn {
  background: rgba(255,255,255,0.15);
  color: {{ section.settings.hero_text }};
  border: 1px solid rgba(255,255,255,0.3);
}
.secondary-btn:hover {
  background: rgba(255,255,255,0.25);
}

/* === SECTION HEADERS === */
.section-header {
  text-align: center;
  margin-bottom: 48px;
}
.section-title {
  font-size: clamp(1.8rem, 4vw, 2.4rem);
  font-weight: 700;
  color: {{ section.settings.text_dark }};
  margin-bottom: 8px;
}
.section-subtitle {
  font-size: 1.05rem;
  color: {{ section.settings.text_light }};
}
.dark-header .section-title { color: #fff; }
.dark-header .section-subtitle { color: #e2e8f0; }

/* === TOP PICKS — ELEGANT CARDS === */
.featured-section {
  padding: 70px 0;
  background: #ffffff;
}
.products-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 28px;
}
.product-card {
  background: #fff;
  border-radius: 16px;
  overflow: hidden;
  box-shadow: 0 2px 14px rgba(0,0,0,0.06);
  border: 1px solid #f1f5f9;
  transition: all 0.35s ease;
  position: relative;
}
.product-card:hover {
  transform: translateY(-6px);
  box-shadow: 0 8px 24px rgba(0,0,0,0.1);
}
.product-image-wrap {
  position: relative;
  width: 100%;
  aspect-ratio: 1 / 1;
  background: #f8fafc;
  overflow: hidden;
}
.product-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.4s ease;
}
.product-card:hover .product-img {
  transform: scale(1.05);
}
.product-no-img {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #94a3b8;
  font-weight: 500;
}
.product-badge {
  position: absolute;
  top: 12px;
  left: 12px;
  background: {{ section.settings.primary }};
  color: #fff;
  font-size: 0.75rem;
  font-weight: 600;
  padding: 4px 10px;
  border-radius: 20px;
}
.product-info {
  padding: 18px;
}
.product-name {
  font-size: 1rem;
  font-weight: 600;
  color: {{ section.settings.text_dark }};
  margin-bottom: 6px;
}
.product-price {
  font-size: 1.15rem;
  font-weight: 700;
  color: {{ section.settings.price_col }};
  margin-bottom: 8px;
}
.product-link {
  font-size: 0.9rem;
  color: {{ section.settings.primary }};
  font-weight: 500;
  opacity: 0;
  transform: translateY(4px);
  transition: all 0.3s ease;
}
.product-card:hover .product-link {
  opacity: 1;
  transform: translateY(0);
}

/* === CATALOGUE SECTION — DARK PREMIUM STYLE === */
.catalogue-section {
  padding: 70px 0;
  background: linear-gradient(135deg, #0f4c42 0%, #00362f 100%);
}
.catalogue-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 28px;
}
.catalogue-card {
  background: #fff;
  border-radius: 16px;
  overflow: hidden;
  box-shadow: 0 4px 16px rgba(0,0,0,0.1);
  transition: all 0.35s ease;
}
.catalogue-card:hover {
  transform: translateY(-6px);
  box-shadow: 0 10px 28px rgba(0,0,0,0.15);
}
.catalogue-image-wrap {
  width: 100%;
  aspect-ratio: 4 / 3;
  background: #f1f5f9;
  overflow: hidden;
}
.catalogue-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.4s ease;
}
.catalogue-card:hover .catalogue-img {
  transform: scale(1.08);
}
.catalogue-no-img {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: {{ section.settings.primary }};
  color: #fff;
  font-weight: 600;
}
.catalogue-info {
  padding: 20px;
  text-align: center;
}
.catalogue-name {
  font-size: 1.15rem;
  font-weight: 700;
  color: {{ section.settings.text_dark }};
  margin-bottom: 4px;
}
.catalogue-count {
  font-size: 0.9rem;
  color: {{ section.settings.text_light }};
}

/* === FEATURES / TRUST BAR === */
.features-section {
  padding: 50px 0;
  background: #f8fafc;
  border-top: 1px solid #e2e8f0;
}
.features-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 30px;
  text-align: center;
}
.feature-item {
  padding: 10px;
}
.feature-icon {
  font-size: 2.2rem;
  margin-bottom: 10px;
}
.feature-item h4 {
  font-size: 1rem;
  font-weight: 600;
  color: {{ section.settings.text_dark }};
  margin-bottom: 4px;
}
.feature-item p {
  font-size: 0.88rem;
  color: {{ section.settings.text_light }};
}

/* === FULLY RESPONSIVE === */
@media (max-width: 968px) {
  .products-grid { grid-template-columns: repeat(2, 1fr); }
  .catalogue-grid { grid-template-columns: repeat(2, 1fr); }
  .features-grid { grid-template-columns: repeat(2, 1fr); }
}
@media (max-width: 520px) {
  .hero-section { padding: 60px 16px; }
  .products-grid { grid-template-columns: 1fr; }
  .catalogue-grid { grid-template-columns: 1fr; }
  .features-grid { grid-template-columns: 1fr; gap: 20px; }
  .hero-buttons { flex-direction: column; width: 100%; max-width: 280px; margin: 0 auto; }
}
</style>
