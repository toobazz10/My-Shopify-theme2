<script>
// ✅ LIGHTWEIGHT SCRIPTS — FAST LOAD
document.addEventListener('DOMContentLoaded', function() {
  // Filter Toggle
  const toggle = document.getElementById('filterToggle');
  const controls = document.getElementById('filterControls');
  if (toggle && controls) {
    controls.style.display = 'none';
    toggle.addEventListener('click', () => {
      controls.style.display = controls.style.display === 'none' ? 'flex' : 'none';
    });
  }

  // Price Slider
  const slider = document.getElementById('priceSlider');
  const value = document.getElementById('priceValue');
  if (slider && value) {
    slider.addEventListener('input', () => value.textContent = slider.value);
  }

  // Quick View Modal
  const modal = document.getElementById('quickViewModal');
  const closeBtn = document.getElementById('modalClose');
  const quickBtns = document.querySelectorAll('.quick-view-btn');

  if (modal && closeBtn) {
    closeBtn.addEventListener('click', () => modal.classList.remove('active'));
    modal.addEventListener('click', e => {
      if (e.target === modal) modal.classList.remove('active');
    });

    quickBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        // Replace with your actual quick view content logic
        document.getElementById('modalContent').innerHTML = '<h3>Product Quick View</h3><p>Full details load here automatically.</p>';
        modal.classList.add('active');
      });
    });
  }
});
</script>

