<style>
/* === BASE === */
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
}
.container {
  max-width: 1200px;
  width: 100%;
  margin: 0 auto;
  padding: 0 20px;
}
a { text-decoration: none; transition: all 0.3s ease; }

/* === HERO — SHORTER & BALANCED === */
.hero-section {
  position: relative;
  background: {{ section.settings.hero_bg }};
  padding: 50px 20px;
}
.hero-overlay {
  position: absolute;
  inset: 0;
  background: radial-gradient(circle at 20% 50%, rgba(255,255,255,0.08), transparent 50%);
}
.hero-content {
  position: relative;
  text-align: center;
  color: {{ section.settings.hero_text_col }};
}
.hero-title {
  font-size: clamp(2rem, 4vw, 2.8rem);
  font-weight: 700;
  margin-bottom: 8px;
}
.hero-subtitle {
  font-size: 1rem;
  opacity: 0.9;
  max-width: 500px;
  margin: 0 auto 24px;
}
.hero-buttons {
  display: flex;
  gap: 12px;
  justify-content: center;
  flex-wrap: wrap;
}
.btn {
  padding: 11px 24px;
  border-radius: 8px;
  font-weight: 600;
  font-size: 0.95rem;
  border: none;
  cursor: pointer;
}
.primary-btn {
  background: {{ section.settings.accent }};
  color: #fff;
  box-shadow: 0 3px 8px rgba(255,143,0,0.2);
}
.primary-btn:hover { transform: translateY(-2px); }
.secondary-btn {
  background: rgba(255,255,255,0.15);
  color: {{ section.settings.hero_text_col }};
  border: 1px solid rgba(255,255,255,0.3);
}

/* === SECTION HEADERS === */
.section-header {
  text-align: center;
  margin-bottom: 32px;
}
.section-title {
  font-size: 1.6rem;
  font-weight: 700;
  color: {{ section.settings.text_dark }};
  margin-bottom: 4px;
}
.section-subtitle {
  font-size: 0.95rem;
  color: #64748b;
}
.dark-header .section-title { color: #fff; }
.dark-header .section-subtitle { color: #e2e8f0; }

/* === TOP PICKS — 3 PER ROW • SMALLER CARDS === */
.featured-section {
  padding: 50px 0;
  background: #fff;
}
.products-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 22px;
}
.product-card {
  background: #fff;
  border-radius: 12px;
  overflow: hidden;
  box-shadow: 0 2px 8px rgba(0,0,0,0.05);
  border: 1px solid #f1f5f9;
  transition: all 0.3s ease;
}
.product-card:hover {
  transform: translateY(-4px);
  box-shadow: 0 5px 14px rgba(0,0,0,0.08);
}
.product-image-wrap {
  width: 100%;
  aspect-ratio: 1 / 1;
  background: #f8fafc;
}
.product-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}
.product-no-img {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #94a3b8;
  font-size: 0.9rem;
}
.product-info {
  padding: 14px;
}
.product-name {
  font-size: 0.95rem;
  font-weight: 600;
  color: {{ section.settings.text_dark }};
  margin-bottom: 4px;
}
.product-price {
  font-size: 1.05rem;
  font-weight: 700;
  color: {{ section.settings.price_col }};
}

/* === CATALOGUE === */
.catalogue-section {
  padding: 50px 0;
  background: linear-gradient(135deg, #0f4c42 0%, #00362f 100%);
}
.catalogue-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 22px;
}
.catalogue-card {
  background: #fff;
  border-radius: 12px;
  overflow: hidden;
  box-shadow: 0 3px 10px rgba(0,0,0,0.08);
  transition: all 0.3s ease;
}
.catalogue-card:hover { transform: translateY(-4px); }
.catalogue-image-wrap {
  width: 100%;
  aspect-ratio: 4 / 3;
  background: #f1f5f9;
}
.catalogue-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}
.catalogue-no-img {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: {{ section.settings.primary }};
  color: #fff;
  font-size: 0.95rem;
  font-weight: 600;
}
.catalogue-info {
  padding: 16px;
  text-align: center;
}
.catalogue-name {
  font-size: 1.05rem;
  font-weight: 700;
  color: {{ section.settings.text_dark }};
  margin-bottom: 2px;
}
.catalogue-count {
  font-size: 0.85rem;
  color: #64748b;
}

/* === FEATURES BAR === */
.features-section {
  padding: 40px 0;
  background: #f8fafc;
  border-top: 1px solid #e2e8f0;
}
.features-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20px;
  text-align: center;
}
.feature-icon {
  font-size: 1.8rem;
  margin-bottom: 6px;
}
.feature-item h4 {
  font-size: 0.95rem;
  font-weight: 600;
  color: {{ section.settings.text_dark }};
  margin-bottom: 2px;
}
.feature-item p {
  font-size: 0.8rem;
  color: #64748b;
}

/* === RESPONSIVE === */
@media (max-width: 900px) {
  .products-grid { grid-template-columns: repeat(2, 1fr); }
  .catalogue-grid { grid-template-columns: repeat(2, 1fr); }
  .features-grid { grid-template-columns: repeat(2, 1fr); }
}
@media (max-width: 520px) {
  .hero-section { padding: 35px 16px; }
  .products-grid { grid-template-columns: 1fr; }
  .catalogue-grid { grid-template-columns: 1fr; }
  .features-grid { grid-template-columns: 1fr; }
}
</style>
