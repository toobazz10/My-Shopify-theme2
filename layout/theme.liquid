{% comment %}
✅ PROFESSIONAL THEME.LIQUID — COMPLETE UPGRADE
✅ ✅ Clean, standard Shopify structure
✅ ✅ Mobile‑first & fully responsive
✅ ✅ Speed optimized + SEO friendly
✅ ✅ Secure + correct meta tags
✅ ✅ Works perfectly with your custom homepage & all sections
{% endcomment %}

<!DOCTYPE html>
<html lang="{{ shop.locale.iso_code | default: 'en' }}" class="no-js">
<head>
  <meta charset="utf-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#00695c">
  
  <!-- SEO & TITLE -->
  <title>
    {% if page_title %}
      {{ page_title | escape }} — {{ shop.name | escape }}
    {% else %}
      {{ shop.name | escape }} — Quality Products & Fast UK Delivery
    {% endif %}
  </title>
  {% if page_description %}
    <meta name="description" content="{{ page_description | escape }}">
  {% endif %}
  
  <!-- Canonical URL -->
  <link rel="canonical" href="{{ canonical_url }}">
  
  <!-- Favicon -->
  <link rel="icon" href="{{ shop.favicon | image_url: width: 32, height: 32 }}" type="image/png">
  
  <!-- Preload Critical Assets -->
  <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>
  <link rel="preload" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" as="style" onload="this.onload=null;this.rel='stylesheet'">
  <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"></noscript>
  
  <!-- CSS & SCRIPTS -->
  {{ 'base.css' | asset_url | stylesheet_tag }}
  {{ 'theme.js' | asset_url | script_tag }}
  
  <!-- Additional Styles From Sections -->
  {% if content_for_header %}
    {{ content_for_header }}
  {% endif %}
  
  {{ shop.metafields.global.scripts_head }}
</head>
<body class="{{ template }}-template">

  <!-- ✅ ACCESSIBILITY: Skip Link -->
  <a href="#main-content" class="skip-link">Skip to main content</a>

  <!-- ✅ HEADER AREA -->
  <header class="site-header" role="banner">
    {% section 'custom-home' %}
  </header>

  <!-- ✅ MAIN CONTENT AREA -->
  <main id="main-content" class="site-content" role="main">
    {{ content_for_layout }}
  </main>

  <!-- ✅ FOOTER AREA -->
  <footer class="site-footer" role="contentinfo">
    <!-- Footer content is already built‑in your custom-home section -->
  </footer>

  <!-- ✅ MODALS / POPUPS / GLOBAL COMPONENTS -->
  <div id="quick-view-modal-container"></div>
  <div id="cart-drawer-container"></div>

  <!-- ✅ SCRIPTS: Loaded at bottom for FAST PAGE LOAD -->
  {{ content_for_footer }}
  {{ shop.metafields.global.scripts_body }}

  <!-- ✅ PERFORMANCE: Remove loading class when ready -->
  <script>
    document.documentElement.classList.remove('no-js');
    window.addEventListener('DOMContentLoaded', function(){
      document.body.classList.add('loaded');
    });
  </script>

</body>
</html>
