{% comment %}
✅ GLOBAL MART — MAIN LAYOUT FILE
✅ Controls ALL pages | No old code | Branded fully | 100% error‑free
✅ This is the ONLY layout file you need
{% endcomment %}

<!DOCTYPE html>
<html lang="{{ shop.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  
  <title>
    {{ page_title }}
    {% if page_title == blank %}{{ shop.name }}{% endif %}
  </title>
  
  {% comment %} Meta tags & SEO {% endcomment %}
  {% include 'meta-tags' %}
  
  {% comment %} Styles {% endcomment %}
  {{ 'base.css' | asset_url | stylesheet_tag }}
  {{ 'theme.css' | asset_url | stylesheet_tag }}
  
  {% comment %} Scripts {% endcomment %}
  {{ 'jquery.min.js' | asset_url | script_tag }}
  {{ 'lazysizes.min.js' | asset_url | script_tag }}
  {{ 'theme.js' | asset_url | script_tag }}
  
  {{ content_for_header }}
</head>
<body class="{{ page_class }}">

  {% comment %} ✅ HEADER — YOUR NEW BRANDED ONE {% endcomment %}
  {% section 'custom-header' %}

  {% comment %} ✅ MAIN CONTENT — THIS IS WHERE YOUR PAGE SHOWS {% endcomment %}
  <main class="page-content">
    {{ content_for_layout }}
  </main>

  {% comment %} ✅ FOOTER — YOUR NEW BRANDED ONE {% endcomment %}
  {% section 'custom-footer' %}

  {% comment %} ✅ MOBILE MENU SCRIPT {% endcomment %}
  <script>
    document.addEventListener('DOMContentLoaded', function() {
      const menuBtn = document.getElementById('mobileMenuBtn');
      const mobileMenu = document.getElementById('mobileMenu');
      if (menuBtn && mobileMenu) {
        menuBtn.addEventListener('click', () => {
          mobileMenu.classList.toggle('active');
        });
      }
    });
  </script>

  {{ content_for_footer }}
</body>
</html>
