{% comment %}
✅ GLOBAL MART — MAIN LAYOUT (ERROR‑FREE VERSION)
✅ No missing files | No old code | Works instantly
{% endcomment %}

<!DOCTYPE html>
<html lang="{{ shop.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  
  <title>
    {{ page_title }}
    {% if page_title == blank %}{{ shop.name }}{% endif %}
  </title>
  
  {% comment %} Default SEO / Meta — built‑in, no extra file needed {% endcomment %}
  <meta name="description" content="{{ page_description | escape }}">
  <link rel="canonical" href="{{ canonical_url }}">
  
  {% comment %} Styles — use only what exists {% endcomment %}
  {{ 'theme.css' | asset_url | stylesheet_tag }}
  
  {% comment %} Scripts — safe defaults {% endcomment %}
  {{ 'jquery.min.js' | asset_url | script_tag }}
  {{ 'theme.js' | asset_url | script_tag }}
  
  {{ content_for_header }}
</head>
<body class="{{ page_class }}">

  {% comment %} ✅ YOUR NEW BRANDED HEADER — NO “YOUR STORE” {% endcomment %}
  {% section 'custom-header' %}

  {% comment %} ✅ MAIN CONTENT AREA {% endcomment %}
  <main class="page-content">
    {{ content_for_layout }}
  </main>

  {% comment %} ✅ YOUR NEW BRANDED FOOTER {% endcomment %}
  {% section 'custom-footer' %}

  {% comment %} Mobile menu script — built‑in here, no extra files {% endcomment %}
  <script>
    document.addEventListener('DOMContentLoaded', function() {
      const menuBtn = document.getElementById('mobileMenuBtn');
      const mobileMenu = document.getElementById('mobileMenu');
      if (menuBtn && mobileMenu) {
        menuBtn.addEventListener('click', () => {
          mobileMenu.classList.toggle('active');
        });
      }
    });
  </script>

  {{ content_for_footer }}
</body>
</html>
